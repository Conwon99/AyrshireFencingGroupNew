---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { Header } from "@/sections/Header";
import { Hero } from "@/pages/service/sections/Hero";
import { ServiceDetail } from "@/pages/service/sections/ServiceDetail";
import { ReviewsSection } from "@/sections/ReviewsSection";
import { ServicesSection } from "@/pages/service/sections/ServicesSection";
import { ServiceProjectsSection } from "@/pages/service/sections/ProjectsSection";
import { FAQ } from "@/pages/service/sections/FAQ";
import { CTASection } from "@/sections/Footer/components/CTASection";
import { Footer } from "@/sections/Footer";

// Only genuine, distinct services are generated. Former keyword-variant and
// location-swap URLs are 301'd or 410'd in static/_redirects (spam update cleanup).
export async function getStaticPaths() {
  return [
    { params: { slug: "fencing" } },
    { params: { slug: "fence-repairs" } },
    { params: { slug: "decking" } },
    { params: { slug: "gates" } },
    { params: { slug: "garden-rooms" } },
    { params: { slug: "outdoor-step-construction-irvine" } },
    { params: { slug: "patio-construction-irvine" } },
  ];
}

const { slug } = Astro.params;

// Generate title based on slug
const getTitle = (slug: string | undefined) => {
  const titleMap: Record<string, string> = {
    "fencing": "Fence Installation Ayrshire | Professional Fencing Services | Ayrshire Fencing Group",
    "fence-repairs": "Fence Repair Ayrshire | Expert Repair & Restoration | Ayrshire Fencing Group",
    "decking": "Decking Installation Ayrshire | Professional Timber Decking | Ayrshire Fencing Group",
    "gates": "Gate Installation Ayrshire | Garden & Security Gates | Ayrshire Fencing Group",
    "garden-rooms": "Garden Rooms Ayrshire | Professional Installation | Ayrshire Fencing Group",
    "patio-construction-irvine": "Patio Construction Ayrshire | Professional Construction | Ayrshire Fencing Group",
    "outdoor-step-construction-irvine": "Outdoor Step Construction Ayrshire | Professional Construction | Ayrshire Fencing Group",
  };
  return titleMap[slug || ""] || "Service - Ayrshire Fencing Group";
};

// Generate meta description based on slug (optimized to 120-160 characters)
const getDescription = (slug: string | undefined) => {
  const descriptionMap: Record<string, string> = {
    "fencing": "Professional fence installation in Ayrshire & Glasgow. Expert contractors, 13+ years experience. Quality materials, free quotes, fully insured.",
    "fence-repairs": "Expert fence repair services in Ayrshire. Fast, reliable repairs for all fence types. Fully qualified contractors, free quotes, 13+ years experience.",
    "decking": "Professional decking installation in Ayrshire & Glasgow. High-quality timber and composite decking. Expert installation, free quotes, 13+ years experience.",
    "gates": "Gate installation services in Ayrshire. Garden gates, security gates, and custom solutions. Professional installation, quality materials, free quotes.",
    "garden-rooms": "Garden room installation in Ayrshire & Glasgow. Professional construction for versatile spaces. Expert installation, free quotes, 13+ years experience.",
    "patio-construction-irvine": "Patio construction in Ayrshire. Professional patio building services. Quality materials, proper base preparation, free quotes.",
    "outdoor-step-construction-irvine": "Outdoor step construction in Ayrshire. Professional step building services. Safe, durable construction, free quotes.",
  };
  return descriptionMap[slug || ""] || "Professional fencing and decking services in Ayrshire. Expert installation, quality materials, free quotes, 13+ years experience.";
};

const pageTitle = getTitle(slug);
const pageDescription = getDescription(slug);
const canonicalUrl = `https://www.ayrshirefencinggroup.com/service/${slug}`;

// Determine if we should show projects section and which category
const showProjects = slug === "fencing" || slug === "fence-repairs" || slug === "decking";
const projectCategory: "fencing" | "decking" = slug === "decking" ? "decking" : "fencing";
---

<BaseLayout title={pageTitle} description={pageDescription} canonical={canonicalUrl}>
    <div class="text-neutral-600 text-lg not-italic normal-nums font-medium accent-auto bg-[#323232] box-border caret-transparent block tracking-[normal] leading-[27px] list-outside list-disc min-h-full pointer-events-auto text-start indent-[0px] normal-case visible border-separate font-manrope">
      <Header client:load />
      <Hero slug={slug} client:only="react" />
      <ServiceDetail slug={slug} client:only="react" />
      {showProjects && <ServiceProjectsSection category={projectCategory} limit={3} client:only="react" />}
      <ReviewsSection client:load />
      <ServicesSection slug={slug} client:only="react" />
      <FAQ slug={slug} client:only="react" />
      <CTASection client:load />
      <Footer client:load />
    </div>
</BaseLayout>

